# Copy this file to .env and fill in your own values.
# Nothing in this repository ships with real credentials - see README.md.

# --- Database (required) ---------------------------------------------------
# Postgres connection string for the stream-fusion-reborn `torrent_items` /
# `debrid_cache` tables.
PG_DSN=postgresql://<user>:<password>@<host>:5432/<database>

# --- Torznab ----------------------------------------------------------------
# Optional API key Prowlarr/Sonarr/Radarr must pass as ?apikey=. Leave empty
# to disable auth (fine on an internal-only docker network).
TORZNAB_API_KEY=
TORZNAB_TITLE=Reborn (stream-fusion)
TORZNAB_LIMIT=200
TORZNAB_HARD_LIMIT=500
TORZNAB_MIN_SEEDERS=0
# Comma-separated language filter applied to every search route, e.g. fr,multi
TORZNAB_LANGUAGES=
# Only return releases already confirmed cached on the debrid service
# (joins against debrid_cache - see WARM_CACHE below).
TORZNAB_CACHED_ONLY=true
TORZNAB_CACHED_SERVICE=alldebrid

# --- TMDB (optional) ---------------------------------------------------------
# Used to resolve tvdbId<->imdbId/tmdbId and to tag original-language releases.
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Cache warming (StreamFusion) --------------------------------------------
# On every ID-based search, hit StreamFusion's own /stream endpoint so it
# verifies debrid availability for this title and writes the result into
# debrid_cache. This is now AWAITED (synchronous): the search response only
# comes back once the check has completed (bounded by WARM_TIMEOUT), so a
# cold title is verified within the same request instead of needing a second
# search a few seconds later.
WARM_CACHE=true
STREMIO_HOST=http://streamfusion:8080
# Base64/urlsafe Stremio addon config blob (from your StreamFusion manifest
# URL: https://<host>/<BLOB>/manifest.json). Either paste it directly here or
# point STREMIO_CONFIG_FILE at a file containing it (default: /data/stremio_config).
STREMIO_CONFIG=
STREMIO_CONFIG_FILE=/data/stremio_config
WARM_TTL=43200
WARM_CONCURRENCY=3
WARM_TIMEOUT=25

# --- Synchronous "instant" search (alternative to WARM_CACHE, off by default) -
# When enabled, returns StreamFusion's own ⚡instant markers directly instead
# of the debrid_cache-backed DB search. Disabled by default: those markers can
# include third-party hash-list guesses that don't always match your debrid
# account's real cache state.
STREMIO_SYNC_SEARCH=false
STREMIO_SYNC_TIMEOUT=90
STREMIO_SYNC_CONCURRENCY=4
STREMIO_SYNC_TTL=600
STREMIO_SYNC_FALLBACK=db
STREMIO_SYNC_UNCACHED=0

# --- Import lists (/list/radarr, /list/sonarr) -------------------------------
# Lets Radarr/Sonarr's "Custom List" / "StevenLu" import list features browse
# the whole catalogue (add as unmonitored, or monitored with search disabled -
# configure that in Radarr/Sonarr itself, not here).
LIST_DAYS=30
LIST_MIN_SEEDERS=5
LIST_LANGUAGES=fr,multi
LIST_RESOLUTIONS=
LIST_LIMIT=2000
LIST_HARD_LIMIT=20000
CACHE_FILE=/data/cache.json
